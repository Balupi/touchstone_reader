<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <!-- Pinned explicitly: Mibo.Raylib 4.1.0 needs a newer FSharp.Core than
         the SDK's implicit reference, which otherwise builds with a
         package-downgrade warning (NU1605). -->
    <PackageReference Update="FSharp.Core" Version="10.1.302" />
    <PackageReference Include="Mibo.Raylib" Version="4.*" />
  </ItemGroup>

</Project>
